# ==========================================
# SMART URBAN NOISE MONITORING SYSTEM
# Environment Variables Configuration
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# If local MongoDB is not installed, backend can optionally use mongodb-memory-server for instant testing
MONGODB_URI=mongodb://127.0.0.1:27017/smart_urban_noise

# JWT Secret Key for token signing
JWT_SECRET=super_secret_jwt_key_change_in_production_998822

# JWT Token Expiration (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:5000/api
