{
  "info": {
    "_postman_id": "smart-urban-noise-api-v1",
    "name": "Smart Urban Noise Monitoring System API",
    "description": "Postman API Collection for testing the Smart Urban Noise Monitoring System REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "citizenToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "complaintId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth - Citizen Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('citizenToken', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"citizen@urban.gov\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Auth - Staff Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('staffToken', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"staff@urban.gov\",\n  \"password\": \"StaffPassword123!\",\n  \"portal\": \"staff\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Citizen - Dashboard Stats",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/stats/citizen-dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["stats", "citizen-dashboard"]
        }
      }
    },
    {
      "name": "Citizen - Submit Complaint",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.complaint && jsonData.complaint._id) {",
              "    pm.collectionVariables.set('complaintId', jsonData.complaint._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Night Construction Heavy Machinery\",\n  \"category\": \"Construction\",\n  \"description\": \"Continuous drilling past 11 PM cutoff.\",\n  \"location\": {\n    \"address\": \"Anna Nagar, Chennai\",\n    \"zone\": \"Anna Nagar\"\n  },\n  \"incidentDate\": \"2026-10-21\",\n  \"incidentTime\": \"23:30\",\n  \"evidenceImageUrl\": \"https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=800\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/complaints",
          "host": ["{{baseUrl}}"],
          "path": ["complaints"]
        }
      }
    },
    {
      "name": "Citizen - Get My Complaints",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/complaints/my",
          "host": ["{{baseUrl}}"],
          "path": ["complaints", "my"]
        }
      }
    },
    {
      "name": "Hotspots - List All Zones",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/hotspots",
          "host": ["{{baseUrl}}"],
          "path": ["hotspots"]
        }
      }
    },
    {
      "name": "Staff - Get All Complaints",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/complaints",
          "host": ["{{baseUrl}}"],
          "path": ["complaints"]
        }
      }
    },
    {
      "name": "Staff - Update Complaint Status",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staffToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Investigating\",\n  \"assignedOfficer\": \"Officer Ramanathan\",\n  \"assignedTeam\": \"Field Squad Zone 8\",\n  \"staffNotes\": \"Field sound sensor deployed at intersection.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/complaints/{{complaintId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["complaints", "{{complaintId}}", "status"]
        }
      }
    }
  ]
}
